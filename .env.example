# --- Required ---

# 32 bytes base64. Generate with: openssl rand -base64 32
MASTER_KEY=

# 32+ bytes random for signing session cookies. openssl rand -base64 48
SESSION_SECRET=

# --- Optional ---

# Path to data directory (sqlite + blobs). Default ./data
DATA_DIR=./data

# API HTTP port
API_PORT=3001

# Comma-separated origins allowed by CORS (frontend URL)
CORS_ORIGIN=http://localhost:3000

# Session DEK cache TTL (idle minutes / hard cap minutes)
KEY_CACHE_IDLE_MIN=30
KEY_CACHE_HARD_MIN=1440

# Set to "true" only when the app is served behind HTTPS. With Secure=true
# over plain HTTP the browser sets the cookie but refuses to send it back,
# which manifests as "I logged in and the page bounces back to /login".
COOKIE_SECURE=false

# Keep the session usable across restarts / image updates without re-entering
# the password. When "true", the decryption key is stored (wrapped with
# MASTER_KEY) inside the already-encrypted session cookie, so the server can
# rehydrate it after a restart. Trade-off: the server secrets (MASTER_KEY +
# SESSION_SECRET) can then recover your data from a cookie without the
# password. Leave "false" for the strict zero-knowledge behaviour.
PERSIST_SESSION_KEY=false

# Only honour X-Forwarded-For for the client IP when behind a trusted reverse
# proxy. Needed for the admin "trusted networks" 2FA bypass to see the real
# client IP. Leave "false" if the app is exposed directly, otherwise a proxy
# header could be spoofed to look like a LAN client and skip 2FA.
TRUSTED_PROXY=false

# Snapshot worker concurrency
SNAPSHOT_CONCURRENCY=2

# OAuth — Google Drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/cloud/connect/gdrive/callback

# OAuth — Microsoft (OneDrive)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:3001/cloud/connect/onedrive/callback

# Public base URL (for share links and OAuth callbacks)
PUBLIC_BASE_URL=http://localhost:3001
